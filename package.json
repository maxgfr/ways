{
  "name": "ways",
  "version": "0.1.0",
  "private": true,
  "description": "A map of how to get around, built only on open data: transit, bikes, walking. No account, no server, no API key.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test src scripts data",
    "regions": "bun data/build.ts dist-data",
    "test:e2e": "bun run build && bun data/fixture.ts dist-data && playwright test"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/figtree": "5.3.0",
    "@preact/signals": "2.11.3",
    "lucide": "1.63.0",
    "maplibre-gl": "6.16.0",
    "minotor": "13.0.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
